# Keep matching credentials consistent across URLs and password fields.
INVHUB_SSH_HOST=your.server
INVHUB_SSH_PORT=22
INVHUB_SSH_USER=root
INVHUB_REMOTE_DIR=/opt/invoice-hub
INVHUB_MYSQL_DSN_INVOICE='app:replace_with_random_hex@tcp(127.0.0.1:23306)/invoice?parseTime=true&loc=UTC&multiStatements=true'
INVHUB_MYSQL_DSN_PROVIDER='app:replace_with_random_hex@tcp(127.0.0.1:23306)/provider?parseTime=true&loc=UTC&multiStatements=true'
INVHUB_MYSQL_DSN_SETTLEMENT='app:replace_with_random_hex@tcp(127.0.0.1:23306)/settlement?parseTime=true&loc=UTC&multiStatements=true'
INVHUB_REDIS_ADDR=127.0.0.1:26379
INVHUB_REDIS_PASSWORD=replace_with_random_hex
INVHUB_AMQP_URL=amqp://app:replace_with_random_hex@127.0.0.1:25672/
INVHUB_MONGO_URI='mongodb://app:replace_with_random_hex@127.0.0.1:37017/?directConnection=true&authSource=admin'
INVHUB_MONGO_DB=invoicehub
INVHUB_MYSQL_ROOT_PASSWORD=replace_with_random_hex
INVHUB_MYSQL_APP_PASSWORD=replace_with_random_hex
INVHUB_RABBITMQ_PASSWORD=replace_with_random_hex
INVHUB_MONGO_ROOT_PASSWORD=replace_with_random_hex
INVHUB_MONGO_APP_PASSWORD=replace_with_random_hex
INVHUB_MONGO_KEYFILE=replace_with_random_hex
